{
  "cli": {
    "version": ">= 14.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_AGORA_APP_ID": "${EXPO_PUBLIC_AGORA_APP_ID}",
        "EXPO_PUBLIC_SERVER_URL": "${EXPO_PUBLIC_SERVER_URL}"
      }
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
