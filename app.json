{
  "expo": {
    "name": "HumClash",
    "slug": "humclash",
    "owner": "deeem06",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "humclash",
    "plugins": [
      "expo-router",
      "expo-sharing"
    ],
    "ios": {
      "newArchEnabled": true,
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "HumClash necesita el micrófono para que tararees canciones a tu rival."
      },
      "bundleIdentifier": "com.humclash.app"
    },
    "android": {
      "newArchEnabled": true,
      "permissions": [
        "RECORD_AUDIO",
        "INTERNET",
        "MODIFY_AUDIO_SETTINGS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#1A0A2E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.humclash.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3d1da7fc-55bf-4724-a5a3-f134605a5481"
      }
    }
  }
}
